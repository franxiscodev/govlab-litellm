# =============================================================================
# GovLab LiteLLM — plantilla de variables de entorno
#
# Copiar a .env y rellenar. El fichero .env NUNCA se versiona (ver .gitignore).
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
# Persistencia de virtual keys, presupuestos y logs de auditoría.
POSTGRES_USER=litellm_admin
POSTGRES_PASSWORD=cambia-esta-password
POSTGRES_DB=litellm_db

# --- LiteLLM Proxy -----------------------------------------------------------
# Llave maestra de administración: autentica en la UI (/ui) y en los endpoints
# administrativos (/key/generate, /team/new). Debe empezar por "sk-".
LITELLM_MASTER_KEY=sk-cambia-esta-master-key

# ATENCIÓN: clave de cifrado de las API keys de proveedores almacenadas en
# PostgreSQL. Es ESTÁTICA — cambiarla después del primer arranque inutiliza
# de forma irreversible todas las credenciales ya cifradas en la base de datos.
LITELLM_SALT_KEY=sk-cambia-esta-salt-key-larga-y-estatica

# --- Proveedores de modelos --------------------------------------------------
# No se usan en el Módulo 1 (solo infraestructura). Necesarias desde el Módulo 2.
OPENAI_API_KEY=sk-tu-api-key-de-openai
ANTHROPIC_API_KEY=sk-ant-tu-api-key-de-anthropic
